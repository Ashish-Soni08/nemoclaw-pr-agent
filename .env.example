# Keys the Lambda VM needs. Export them in the shell that runs the scripts; never commit
# a filled-in copy and never paste them in chat. The scripts hand them to the OpenShell
# gateway, and the sandbox only ever sees placeholders.

# scripts/install.sh: inference through router.huggingface.co (Inference Providers permission)
HF_TOKEN=""
# scripts/install.sh: run summaries. Bot from @BotFather; your numeric id from @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_IDS=""

# scripts/setup-credentials.sh
# Classic token with only the public_repo scope, for the account that opens PRs.
# (Fine-grained tokens can't comment or open PRs on repos you aren't a member of.)
# Never give it admin or full repo scope: test code from other people's repos runs nearby.
GITHUB_TOKEN=""
FIRECRAWL_API_KEY=""

# scripts/sync-ledger.sh (host crontab): HF token with write access to the dataset
LEDGER_DATASET=""
