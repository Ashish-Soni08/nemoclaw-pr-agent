#!/usr/bin/env bash
# Run the pr-agent CLI from this checkout, with Hermes' Python when present
# (it has PyYAML, and it is the binary the sandbox egress policies allow).
set -euo pipefail
REPO="${PR_AGENT_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
# In the sandbox, deploy.sh puts a private copy of python3 at /sandbox/.pr-agent/bin/python.
# The GitHub and Firecrawl keys are injected only for that path, so other people's test
# suites (venvs built from /usr/bin/python3) never get them.
PY="${PR_AGENT_PYTHON:-}"
for cand in /sandbox/.pr-agent/bin/python /opt/hermes/.venv/bin/python; do
  [[ -z "$PY" && -x "$cand" ]] && PY="$cand"
done
[[ -n "$PY" ]] || PY="$(command -v python3)"
export PR_AGENT_REPO="$REPO"
export PYTHONPATH="$REPO/src${PYTHONPATH:+:$PYTHONPATH}"
if [[ "$PY" == /sandbox/.pr-agent/bin/python ]]; then
  # A copied interpreter doesn't find the system site-packages (PyYAML) on its own.
  PYTHONPATH="$PYTHONPATH:$(python3 -c 'import sys; print(":".join(p for p in sys.path[1:] if p))')"
fi
exec "$PY" -m pr_agent.cli "$@"
